<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permisos personalizados del Punto 3: controlan quién puede leer/escribir
         las tareas de App A a través del ContentProvider. -->
    <permission
        android:name="com.example.mistareas.permission.READ_TASKS"
        android:protectionLevel="normal" />

    <permission
        android:name="com.example.mistareas.permission.WRITE_TASKS"
        android:protectionLevel="normal" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MisTareas">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ContentProvider del Punto 3: expone la tabla local "tareas" a
             aplicaciones externas (App B) de forma controlada. -->
        <provider
            android:name=".provider.TareaContentProvider"
            android:authorities="com.example.mistareas.provider"
            android:exported="true"
            android:readPermission="com.example.mistareas.permission.READ_TASKS"
            android:writePermission="com.example.mistareas.permission.WRITE_TASKS" />
    </application>

</manifest>
